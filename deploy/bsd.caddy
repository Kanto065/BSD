# BSD (bsd.wales). Copied to /opt/caddy-sites.d/bsd.caddy on the VPS by /opt/bsd/deploy.sh.
# The shared Caddy imports /opt/caddy-sites.d/*.caddy (see the platform repo's Caddyfile),
# so this file survives that project's own deploys.
bsd.wales {
	encode gzip

	# Uploaded business photos and logos. They are stored in the "bsd-uploads" bucket on the MinIO server that is
	# shared with the restaurant platform, under the public/ prefix (anonymous read, no listing). Only GET and HEAD
	# reach MinIO. Keys are random and never reused, so responses can be cached for a year.
	handle_path /uploads/* {
		@write not method GET HEAD
		respond @write 405

		rewrite * /bsd-uploads/public{path}
		reverse_proxy minio:9000 {
			header_down -Server
			header_down -X-Amz-Request-Id
			header_down -X-Amz-Id-2
		}
		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options "nosniff"
			Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
			Cross-Origin-Resource-Policy "same-site"
		}
	}

	handle {
		reverse_proxy bsd-web:3000
	}
}

www.bsd.wales {
	redir https://bsd.wales{uri} permanent
}

api.bsd.wales {
	encode gzip
	reverse_proxy bsd-api:4000
}
