DATABASE_URL="postgresql://bsd:CHANGE_ME@postgres:5432/bsd?schema=public"
JWT_SECRET="CHANGE_ME_LONG_RANDOM_STRING"
PORT=4000
# Privilege Pass QR signing secret, at least 32 random characters (openssl rand -base64 48). Different from JWT_SECRET.
# Missing in production means the pass is switched off, nothing else is affected.
PASS_TOKEN_SECRET="CHANGE_ME_LONG_RANDOM_STRING_32_PLUS"
# Seconds each QR code lasts (5 to 600). A code is accepted for its own interval and the one before. Default 30.
PASS_QR_SECONDS=30
CORS_ORIGIN="https://bsd.wales,https://card.bsd.wales,https://marketplace.bsd.wales"
# A login address that is NOT a public mailbox (admin@bsd.wales is the public partnerships mailbox).
SEED_ADMIN_EMAIL="CHANGE_ME_non_public_login@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
POSTGRES_PASSWORD="CHANGE_ME"
