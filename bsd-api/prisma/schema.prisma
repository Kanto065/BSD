generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Moderation state, set by admins.
enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

// Community verification state, kept separate from moderation. Badge colours are
// blue (NEWLY_LISTED), yellow (PENDING_VERIFICATION) and green (COMMUNITY_VERIFIED).
enum VerificationStatus {
  NEWLY_LISTED
  PENDING_VERIFICATION
  COMMUNITY_VERIFIED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  VOLUNTEER // can change verification status only (enforced by the M3 admin routes)
}

// The four v2 mailboxes.
enum ContactType {
  SUPPORT // support@bsd.wales: general, listing help, urgent corrections
  COMPLIANCE // compliance@bsd.wales: privacy and GDPR
  COMMUNITY // community@bsd.wales: outreach, volunteers, feedback
  ADMIN // admin@bsd.wales: partnerships, governance
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminUser {
  id                 String                  @id @default(cuid())
  name               String
  email              String                  @unique
  passwordHash       String
  role               AdminRole               @default(MODERATOR)
  createdAt          DateTime                @default(now())
  active             Boolean                 @default(true) // a disabled account cannot log in
  mustChangePassword Boolean                 @default(false) // set for first-time and reset passwords
  failedLoginCount   Int                     @default(0)
  lockedUntil        DateTime? // temporary lock after repeated failed logins
  lastLoginAt        DateTime?
  tokenVersion       Int                     @default(0) // bumped on password change or logout, which ends all sessions
  decidedStudents    StudentVerification[]
  reviewedListings   Business[]              @relation("ReviewedBy")
  verifiedListings   Business[]              @relation("VerifiedBy")
  claimReviews       ListingClaimRequest[]   @relation("ClaimReviewedBy")
  updateReviews      ListingUpdateRequest[]  @relation("UpdateReviewedBy")
  removalReviews     ListingRemovalRequest[] @relation("RemovalReviewedBy")
  auditLogs          AuditLog[]
  decidedOffers      PrivilegeOffer[]
}

// A category typed in through "Others" on the Submit form starts PENDING (hidden from the public site) until an
// admin approves, merges or rejects it. REJECTED rows stay so the same text is not proposed again.
enum CategoryStatus {
  APPROVED
  PENDING
  REJECTED
}

model Category {
  id                String         @id @default(cuid())
  name              String         @unique
  slug              String         @unique
  description       String?
  icon              String?
  sortOrder         Int            @default(0)
  requiresOwnerName Boolean        @default(false)
  status            CategoryStatus @default(APPROVED)
  // Suggested "Services Offered" hashtags, stored without the leading #. Suggestions on forms, never a closed list.
  serviceTags       String[]       @default([])
  // Hidden from every public list and from new choices until an admin unlocks it. Listings already in it stay visible.
  staged            Boolean        @default(false)
  submittedAt       DateTime? // set when the category came from the Others field
  submittedByUserId String? // the member who proposed it, for the per-account cap
  submittedBy       User?          @relation("CategorySubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  subcategories     Subcategory[]
  businesses        Business[]
}

model Subcategory {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  // Position within its category, set by admins (drag to reorder). The site lists subcategories in this order.
  sortOrder  Int        @default(0)
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id])
  businesses Business[]

  @@unique([categoryId, name])
}

// Replaces the flat CoverageArea list. Three zones cover SA1 to SA34 (Regional Coverage Factsheet).
model CoverageZone {
  id                String               @id @default(cuid())
  name              String               @unique
  slug              String               @unique // zone-1, zone-2, zone-3
  postcodeDistricts String[] // outward codes that belong to this zone, e.g. SA1, SA2
  sortOrder         Int                  @default(0)
  localities        Locality[]
  businesses        Business[]
  servedBy          BusinessServedZone[]
}

model Locality {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  zoneId     String
  zone       CoverageZone       @relation(fields: [zoneId], references: [id])
  businesses BusinessLocality[]

  @@unique([zoneId, name])
}

model Business {
  id                 String               @id @default(cuid())
  slug               String               @unique
  name               String
  categoryId         String
  category           Category             @relation(fields: [categoryId], references: [id])
  subcategoryId      String?
  subcategory        Subcategory?         @relation(fields: [subcategoryId], references: [id])
  description        String
  servicesOffered    String[]
  ownerName          String?
  phone              String
  whatsapp           String?
  email              String?
  showEmail          Boolean              @default(false) // public pages show the email only when true, admin always sees it
  hideFullAddress    Boolean              @default(false) // true hides the street and full postcode on public pages, admin and owner still see them
  websiteOrSocial    String?
  address            String?
  postcode           String // normalised full UK postcode, e.g. "SA1 4PE"
  postcodeDistrict   String // outward code, e.g. "SA1". Public pages show this for HomeBased listings.
  zoneId             String // derived from the postcode, never typed by the submitter
  zone               CoverageZone         @relation(fields: [zoneId], references: [id])
  servedZones        BusinessServedZone[]
  localities         BusinessLocality[]
  otherAreaText      String?
  openingHours       String?
  specialNotes       String?
  status             ListingStatus        @default(PENDING)
  verificationStatus VerificationStatus   @default(NEWLY_LISTED)
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         AdminUser?           @relation("VerifiedBy", fields: [verifiedById], references: [id])

  consentAccurateInfo      Boolean @default(false)
  consentPublishPermission Boolean @default(false)
  consentNoLiability       Boolean @default(false)
  consentDataStorage       Boolean @default(false)
  gdprConsentStorage       Boolean @default(false)
  gdprConsentRights        Boolean @default(false)

  submittedAt     DateTime   @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      AdminUser? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  rejectionReason String?

  // The member who submitted it, or an admin linked them. Null for older anonymous listings (never matched by email).
  ownerUserId   String?
  owner         User?     @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerEditedAt DateTime?

  photos          BusinessPhoto[]
  updateRequests  ListingUpdateRequest[]
  removalRequests ListingRemovalRequest[]
  claimRequests   ListingClaimRequest[]
  privilegeOffer  PrivilegeOffer?

  @@index([status, verificationStatus])
  @@index([zoneId])
  @@index([postcodeDistrict])
  @@index([categoryId])
  @@index([ownerUserId])
}

// Replaces BusinessCoverageArea.
model BusinessLocality {
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  localityId String
  locality   Locality @relation(fields: [localityId], references: [id])

  @@id([businessId, localityId])
}

// The "Areas you serve" zone checkboxes on the submission form.
model BusinessServedZone {
  businessId String
  business   Business     @relation(fields: [businessId], references: [id])
  zoneId     String
  zone       CoverageZone @relation(fields: [zoneId], references: [id])

  @@id([businessId, zoneId])
}

// Images live in S3-compatible storage (MinIO). url is the full-size stored image and thumbUrl a smaller
// high-quality WebP for cards and grids (null when the original is already small). Both are site-relative paths
// under /uploads. sizeBytes is the size of the stored full-size file.
model BusinessPhoto {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  url        String
  thumbUrl   String?
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  isLogo     Boolean  @default(false)
  uploadedAt DateTime @default(now())
}

model ListingUpdateRequest {
  id               String     @id @default(cuid())
  businessId       String
  business         Business   @relation(fields: [businessId], references: [id])
  requestedChanges Json // { message: "what should change" } from the public form
  status           String     @default("PENDING") // PENDING, APPLIED, REJECTED
  requestedAt      DateTime   @default(now())
  requesterName    String?
  requesterEmail   String?
  requesterPhone   String?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNote       String?
  reviewedBy       AdminUser? @relation("UpdateReviewedBy", fields: [reviewedById], references: [id])
}

model ListingRemovalRequest {
  id             String     @id @default(cuid())
  businessId     String
  business       Business   @relation(fields: [businessId], references: [id])
  reason         String?
  isEmergency    Boolean    @default(false) // incorrect or sensitive information: 24-hour target
  status         String     @default("PENDING") // PENDING, REMOVED, REJECTED
  requestedAt    DateTime   @default(now())
  requesterName  String?
  requesterEmail String?
  requesterPhone String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  reviewedBy     AdminUser? @relation("RemovalReviewedBy", fields: [reviewedById], references: [id])
}

// "Claim This Listing" with proof of ownership (Homepage Full Body FAQ Q4).
model ListingClaimRequest {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id])
  claimantName  String
  claimantEmail String
  claimantPhone String?
  proofText     String
  proofFileUrl  String?
  status        ClaimStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    AdminUser?  @relation("ClaimReviewedBy", fields: [reviewedById], references: [id])

  // M9-D. A claim by a signed-in member, with an optional private document (same rules as StudentVerification).
  // Anonymous rows from before keep userId null. Hand written in the migration: one PENDING claim per member per listing.
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  proofKey     String? // private storage key, never returned by any route
  proofType    String?
  proofBytes   Int?
  purgeAt      DateTime? // the file is deleted at this time, 24 hours after a decision or 7 days after upload
  purgedAt     DateTime?
  decisionNote String? // shown to the member when the claim is not approved
  linkedOwner  Boolean   @default(false) // approval also made the member the owner

  @@index([userId])
  @@index([purgeAt])
}

model ContactMessage {
  id        String      @id @default(cuid())
  type      ContactType
  name      String
  email     String
  message   String
  createdAt DateTime    @default(now())
  status    String      @default("OPEN")
}

// Site-wide settings the admin edits (R-04, R-05, R-07). One row per key, value is validated JSON.
//   maintenance  { enabled, textEn, textBn }
//   sections     { items: { [sectionKey]: { visible, title, body } }, order: string[] }
// An empty table means the site looks exactly as it did before this table existed.
model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime  @default(now())
}

// Phase 2 shared login. One account (User.id is the central_sso_id) works on bsd.wales, card.bsd.wales and
// marketplace.bsd.wales. Separate from AdminUser, which stays the team login.
enum SiteModule {
  DIRECTORY
  CARD
  MARKETPLACE
}

enum MemberBadge {
  STUDENT
  VOLUNTEER
  MEMBER
}

// A self-declared claim at sign-up. Only the STUDENT badge means verified.
enum AccountType {
  GENERAL
  STUDENT
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String
  postcode             String
  postcodeDistrict     String
  createdAt            DateTime              @default(now())
  lastLoginAt          DateTime?
  failedLoginCount     Int                   @default(0)
  lockedUntil          DateTime?
  tokenVersion         Int                   @default(0) // bumped on password change, which ends every session
  accountType          AccountType           @default(GENERAL)
  phone                String? // optional contact number, never used to sign in
  deletedAt            DateTime? // set when the member deletes the account, see DELETE /auth/me
  modules              UserModule[]
  badges               UserBadge[]
  businessProfile      BusinessProfile?
  businesses           Business[]            @relation("BusinessOwner")
  categories           Category[]            @relation("CategorySubmitter")
  studentVerifications StudentVerification[]
  claimRequests        ListingClaimRequest[]
  privilegeCard        PrivilegeCard?
}

// The saved business details of one member, reused to prefill forms. Json until a field needs to be queried.
model BusinessProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  step      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Which of the three sites a person has joined.
model UserModule {
  userId    String
  module    SiteModule
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
}

model UserBadge {
  userId    String
  badge     MemberBadge
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badge])
}

// R-11. A member's proof of student status. The file lives under the private storage prefix and is deleted
// 24 hours after the decision (7 days after upload if nobody decided). The row stays as the record of the decision.
// The SQL also has a partial unique index (one PENDING row per user) that Prisma cannot express.
enum StudentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model StudentVerification {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          StudentStatus @default(PENDING)
  proofKey        String? // null once the file is purged
  proofType       String
  proofBytes      Int
  note            String?
  submittedAt     DateTime      @default(now())
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       AdminUser?    @relation(fields: [decidedById], references: [id])
  rejectionReason String?
  purgeAt         DateTime
  purgedAt        DateTime?

  @@index([status, submittedAt])
  @@index([purgeAt])
}

// M11-A Privilege Pass. One card per member. `secret` never leaves the API. `deviceHash` is sha256(deviceId + card id),
// the raw device id is never stored. Moves are counted per 7 day window (deviceMoves, deviceMovesResetAt).
enum CardStatus {
  ACTIVE
  SUSPENDED
}

enum OfferStatus {
  PENDING
  ACTIVE
  PAUSED
  REJECTED
}

enum RedeemMethod {
  QR
  CODE
}

model PrivilegeCard {
  id                 String                @id @default(cuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardNumber         String                @unique
  level              Int                   @default(1)
  status             CardStatus            @default(ACTIVE)
  secret             String
  deviceHash         String?
  deviceBoundAt      DateTime?
  deviceMoves        Int                   @default(0)
  deviceMovesResetAt DateTime?
  createdAt          DateTime              @default(now())
  codes              PrivilegeCode[]
  redemptions        PrivilegeRedemption[]
}

model PrivilegeOffer {
  id              String                @id @default(cuid())
  businessId      String                @unique
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  percent         Decimal?              @db.Decimal(5, 2)
  terms           String
  featured        Boolean               @default(false)
  status          OfferStatus           @default(PENDING)
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       AdminUser?            @relation(fields: [decidedById], references: [id])
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  codes           PrivilegeCode[]
  redemptions     PrivilegeRedemption[]
}

model PrivilegeCode {
  id        String         @id @default(cuid())
  cardId    String
  card      PrivilegeCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  offerId   String
  offer     PrivilegeOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  usedAt    DateTime?

  @@unique([offerId, code])
  @@index([cardId])
}

model PrivilegeRedemption {
  id              String         @id @default(cuid())
  cardId          String
  card            PrivilegeCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  offerId         String
  offer           PrivilegeOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  businessId      String
  scannedByUserId String
  method          RedeemMethod
  scannedAt       DateTime       @default(now())
  confirmedAt     DateTime?
  billPence       Int?
  savingPence     Int?

  @@index([businessId, scannedAt])
  @@index([cardId, scannedAt])
}
